{
  "name": "employee-time-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "TZ=Europe/Chisinau vitest run",
    "check:scenarios": "node scripts/check-scenarios.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "seed": "node --experimental-strip-types scripts/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
